{
  "rewrites": [
    {
      "source": "/:page(features|parishes|about|contact)",
      "has": [
        {
          "type": "host",
          "value": "getinfold.app"
        }
      ],
      "destination": "/m/:page.html"
    },
    {
      "source": "/:page(features|parishes|about|contact)",
      "has": [
        {
          "type": "host",
          "value": "www.getinfold.app"
        }
      ],
      "destination": "/m/:page.html"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "getinfold.app"
        }
      ],
      "destination": "/marketing.html"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.getinfold.app"
        }
      ],
      "destination": "/marketing.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
