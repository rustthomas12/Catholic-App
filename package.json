    "formdata-node": "^6.0.3",
    "i18next": "^26.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "postcss": "^8.5.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0",
    "stripe": "^22.1.0",
    "tailwindcss": "^3.4.19",
