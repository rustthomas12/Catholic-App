{
  "name": "catholic-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:build": "vite build && cap sync",
    "mobile:ios": "vite build && cap sync ios && cap open ios",
    "mobile:android": "vite build && cap sync android && cap open android",
    "mobile:assets": "node scripts/generate-app-assets.mjs && capacitor-assets generate --ios --android --iconBackgroundColor \"#1B2A4A\" --iconBackgroundColorDark \"#1B2A4A\" --splashBackgroundColor \"#1B2A4A\" --splashBackgroundColorDark \"#1B2A4A\""
  },
