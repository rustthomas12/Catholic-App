<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode switches this to "production" when the
	     build is signed for TestFlight / App Store distribution. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: https://app.getcommunio.app/... opens the app.
	     Requires public/.well-known/apple-app-site-association on the site. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.getcommunio.app</string>
	</array>
</dict>
</plist>
